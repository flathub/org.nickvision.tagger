{
    "app-id" : "org.nickvision.tagger",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "49",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.dotnet8"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/dotnet8/bin",
        "append-ld-library-path": "/usr/lib/sdk/dotnet8/lib",
        "append-pkg-config-path": "/usr/lib/sdk/dotnet8/lib/pkgconfig"
    },
    "command" : "org.nickvision.tagger",
    "finish-args":[
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--filesystem=home"
    ],
    "cleanup":[
        "/include",
        "/lib/pkgconfig",
        "*.a"
    ],
    "modules" : [
        {
            "name": "chromaprint",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE:STRING=Release",
                "-DBUILD_TOOLS:BOOL=ON",
                "-DFFT_LIB:STRING=avfft"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/acoustid/chromaprint/releases/download/v1.5.1/chromaprint-1.5.1.tar.gz",
                    "sha256": "a1aad8fa3b8b18b78d3755b3767faff9abb67242e01b478ec9a64e190f335e1c",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 286,
                        "stable-only": true,
                        "url-template": "https://github.com/acoustid/chromaprint/releases/download/v$version/chromaprint-$version.tar.gz"
                    }
                },
                {
                    "type": "patch",
                    "path": "chromaprint_ffmpeg5.patch"
                }
            ],
            "cleanup": [
                "/include",
                "/lib/pkgconfig"
            ]
        },
        {
            "name": "org.nickvision.tagger",
            "buildsystem": "simple",
            "build-commands": [
                "chmod +x ./flatpak/build.sh",
                "./flatpak/build.sh gnome"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/NickvisionApps/Tagger.git",
                    "tag": "2024.6.0-1"
                },
                "nuget-sources.json"
            ]
        }
    ]
}
